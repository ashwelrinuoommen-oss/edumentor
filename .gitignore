# =============================================================================
# EduMentor — Security & Privacy .gitignore (Phase 35)
# Prevents student notes, database records, API keys, and secrets from entering Git
# =============================================================================

# --- Environment & Sensitive Credentials ---
.env
.env.local
.env.*.local
*.env
!.env.example
.streamlit/secrets.toml
secrets/
*.pem
*.key
*.cert
*.p12

# --- Relational Databases & SQLite WAL Files ---
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
edumentor.db*

# --- Student Uploads & Temporary Storage ---
temp/
tmp/
temp_*
edumentor_sec_*
scratch/
uploads/
*.tmp
*.temp

# --- Python Bytecode & Environments ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# System & Editor Artifacts
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~
*.log
