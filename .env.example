# EduMentor Environment Configuration
# Copy this file to .env and configure your desired provider

# AI Provider Selection: demo | anthropic | openai | gemini | ollama
LLM_PROVIDER=demo

# Cloud LLM API Keys (Required only if LLM_PROVIDER is set accordingly)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Local Ollama endpoint (Optional)
OLLAMA_BASE_URL=http://localhost:11434

# Application & Port Settings
STREAMLIT_PORT=8501
FASTAPI_PORT=8000
DATABASE_PATH=edumentor.db
